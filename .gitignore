# Virtual Environment
.venv/
env/
venv/

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs (abaikan isinya, pertahankan direktori dengan .gitkeep)
logs/*
!logs/.gitkeep

# Data interim (hanya simpan data mentah dan data processed)
data/interim/*
!data/interim/.gitkeep

# Format biner tidak terlacak
*.npy
*.parquet

# LaTeX temporary files
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.toc
